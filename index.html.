        let hasSelectedCard = false;

        // Algoritmo Fisher-Yates para barajar perfectamente
        function shuffle(array) {
            let currentIndex = array.length, randomIndex;
            const newArray = [...array];
            while (currentIndex !== 0) {
                randomIndex = Math.floor(Math.random() * currentIndex);
                currentIndex--;
                [newArray[currentIndex], newArray[randomIndex]] = [newArray[randomIndex], newArray[currentIndex]];
            }
            return newArray;
        }

        function renderGrid() {
            const grid = document.getElementById('cardsGrid');
            grid.innerHTML = '';
            hasSelectedCard = false;

            const shuffledDeck = shuffle(deck);

            shuffledDeck.forEach((cardData, idx) => {
                const cardEl = document.createElement('div');
                cardEl.className = 'card-container';
                
                cardEl.innerHTML = `
                    <div class="card" style="transition-delay: ${idx * 25}ms">
                        <div class="card-face card-back">
                            <svg class="card-back-svg" viewBox="0 0 100 100" fill="none">
                                <circle cx="50" cy="50" r="42" stroke="#d4af37" stroke-width="1.5" stroke-dasharray="3 2"/>
                                <polygon points="50,15 61,38 85,50 61,62 50,85 39,62 15,50 39,38" fill="none" stroke="#d4af37" stroke-width="1.5"/>
                                <circle cx="50" cy="50" r="10" fill="#d4af37"/>
                            </svg>
                        </div>
                        <div class="card-face card-front">
                            <span class="card-num">${cardData.id}</span>
                            <div class="card-icon-wrap">
                                ${svgIcons[cardData.key]}
                            </div>
                            <div class="card-title">${cardData.name}</div>
                        </div>
                    </div>
                `;

                cardEl.addEventListener('click', () => selectCard(cardEl, cardData));
                grid.appendChild(cardEl);
            });
        }

        function selectCard(container, data) {
            if (hasSelectedCard) return;
            hasSelectedCard = true;

            const card = container.querySelector('.card');
            card.classList.add('flipped');

            setTimeout(() => {
                document.getElementById('modalIcon').innerHTML = svgIcons[data.key];
                document.getElementById('modalTitle').innerText = data.name;
                document.getElementById('modalReading').innerText = `"${data.meaning}"`;
                document.getElementById('modalOverlay').classList.add('active');
            }, 850);
        }

        function closeModalAndShuffle() {
            document.getElementById('modalOverlay').classList.remove('active');
            setTimeout(() => {
                renderGrid();
            }, 300);
        }

        // Inicializar al cargar
        window.addEventListener('DOMContentLoaded', renderGrid);
    </script>
</body>
</html>
