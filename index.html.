<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MORENAS Ritual - Lectura de Tarot</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0f0a0a;
            --bg-wood: #18100e;
            --gold: #d4af37;
            --gold-light: #f3e5ab;
            --gold-dark: #997a15;
            --pergamino: #eddcb5;
            --pergamino-dark: #d6c193;
            --text-dark: #21160e;
            --text-light: #f5eedc;
            --shadow: 0 10px 30px rgba(0,0,0,0.8);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            font-family: 'Cormorant Garamond', serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px 12px 40px;
            background-image: 
                radial-gradient(circle at 50% 20%, rgba(212, 175, 55, 0.12) 0%, transparent 60%),
                radial-gradient(circle at 50% 80%, rgba(107, 59, 167, 0.08) 0%, transparent 50%),
                linear-gradient(180deg, #0a0707 0%, #170e0a 50%, #0a0707 100%);
            position: relative;
            overflow-x: hidden;
        }

        /* Hojas de Monstera integradas en las esquinas */
        .leaf-decor {
            position: fixed;
            pointer-events: none;
            z-index: 1;
            opacity: 0.35;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.9));
        }

        .leaf-top-left {
            top: -30px;
            left: -30px;
            width: 140px;
            transform: rotate(25deg);
        }

        .leaf-bottom-right {
            bottom: -30px;
            right: -30px;
            width: 150px;
            transform: rotate(-135deg);
        }

        /* Encabezado con Logo estilo Morenas Ritual */
        header {
            text-align: center;
            margin-bottom: 25px;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .logo-frame {
            width: 85px;
            height: 85px;
            border-radius: 50%;
            border: 2px solid var(--gold);
            padding: 4px;
            background: radial-gradient(circle, #2a1b15 0%, #0f0a0a 100%);
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.4), inset 0 0 10px rgba(0,0,0,0.8);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-svg {
            width: 100%;
            height: 100%;
        }

        h1 {
            font-family: 'Cinzel', serif;
            color: var(--gold);
            font-size: 1.8rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-weight: 700;
            text-shadow: 0 0 12px rgba(212, 175, 55, 0.4);
            margin-bottom: 2px;
        }

        .tagline {
            font-family: 'Cinzel', serif;
            color: var(--gold-light);
            font-size: 0.8rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            opacity: 0.85;
            margin-bottom: 10px;
        }

        .subtitle {
            font-size: 1.05rem;
            color: #d1c4a5;
            font-style: italic;
            max-width: 320px;
            line-height: 1.3;
        }

        /* Grid de Cartas */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            width: 100%;
            max-width: 440px;
            perspective: 1000px;
            z-index: 2;
            margin-bottom: 20px;
        }

        .card-container {
            aspect-ratio: 2 / 3.4;
            cursor: pointer;
            perspective: 1000px;
        }

        .card {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border-radius: 8px;
            box-shadow: 0 6px 15px rgba(0,0,0,0.7);
        }

        .card.flipped {
            transform: rotateY(180deg);
        }

        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 6px;
            box-sizing: border-box;
            border: 1.5px solid var(--gold);
        }

        /* Reverso oscuro con ornamento dorado */
        .card-back {
            background: linear-gradient(135deg, #1f1412 0%, #110a09 100%);
            box-shadow: inset 0 0 12px rgba(212, 175, 55, 0.2);
            overflow: hidden;
        }

        .card-back::before {
            content: '';
            position: absolute;
            inset: 3px;
            border: 1px dashed rgba(212, 175, 55, 0.5);
            border-radius: 5px;
            pointer-events: none;
        }

        .card-back-svg {
            width: 65%;
            height: 65%;
            margin: auto;
            opacity: 0.9;
        }

        /* Anverso estilo Pergamino */
        .card-front {
            background: radial-gradient(circle, var(--pergamino) 0%, var(--pergamino-dark) 100%);
            color: var(--text-dark);
            transform: rotateY(180deg);
            border: 2px solid var(--gold-dark);
            box-shadow: inset 0 0 10px rgba(80, 50, 20, 0.3);
        }

        .card-front::before {
            content: '';
            position: absolute;
            inset: 3px;
            border: 1px solid rgba(153, 122, 21, 0.4);
            border-radius: 5px;
            pointer-events: none;
        }

        .card-num {
            font-family: 'Cinzel', serif;
            font-size: 0.65rem;
            font-weight: 700;
            color: #634710;
        }

        .card-icon-wrap {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card-icon-svg {
            width: 100%;
            height: 100%;
            fill: #422f0c;
        }

        .card-title {
            font-family: 'Cinzel', serif;
            font-size: 0.62rem;
            font-weight: 700;
            text-align: center;
            line-height: 1.1;
            color: #2b1b08;
            text-transform: uppercase;
            border-top: 1px solid rgba(99, 71, 16, 0.3);
            padding-top: 2px;
            width: 95%;
        }

        /* Modal con Lectura Completa */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 6, 6, 0.92);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 100;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-card {
            background: radial-gradient(circle at top, var(--pergamino) 0%, var(--pergamino-dark) 100%);
            border: 3px solid var(--gold);
            border-radius: 12px;
            padding: 28px 22px 24px;
            max-width: 380px;
            width: 100%;
            text-align: center;
            box-shadow: 0 0 35px rgba(212, 175, 55, 0.5), 0 15px 35px rgba(0,0,0,0.9);
            color: var(--text-dark);
            position: relative;
            animation: modalAppear 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes modalAppear {
            from { opacity: 0; transform: scale(0.85) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .modal-card::before {
            content: '';
            position: absolute;
            inset: 6px;
            border: 1px solid rgba(153, 122, 21, 0.5);
            border-radius: 8px;
            pointer-events: none;
        }

        .modal-icon-container {
            width: 65px;
            height: 65px;
            margin: 0 auto 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-icon-container svg {
            width: 100%;
            height: 100%;
            fill: #5e430d;
        }

        .modal-subtitle {
            font-family: 'Cinzel', serif;
            font-size: 0.75rem;
            letter-spacing: 3px;
            color: #7a5813;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .modal-title {
            font-family: 'Cinzel', serif;
            font-size: 1.5rem;
            color: #2b1c09;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 14px;
            border-bottom: 1px solid rgba(122, 88, 19, 0.3);
            padding-bottom: 8px;
        }

        .modal-reading {
            font-size: 1.15rem;
            line-height: 1.5;
            color: #26190b;
            font-style: italic;
            margin-bottom: 22px;
            padding: 0 5px;
        }

        .btn-ritual {
            background: linear-gradient(135deg, #d4af37 0%, #a68119 100%);
            color: #120b08;
            border: 1px solid var(--gold-light);
            padding: 12px 28px;
            font-family: 'Cinzel', serif;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.4);
            transition: all 0.2s ease;
        }

        .btn-ritual:active {
            transform: scale(0.95);
            box-shadow: 0 2px 8px rgba(0,0,0,0.6);
        }

        @media (max-width: 380px) {
            .cards-grid {
                gap: 8px;
            }
            .card-title {
                font-size: 0.55rem;
            }
            h1 {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
